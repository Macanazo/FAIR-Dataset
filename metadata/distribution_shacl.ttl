@prefix :         <http://fairdatapoint.org/> .
@prefix dash:     <http://datashapes.org/dash#> .
@prefix dcat:     <http://www.w3.org/ns/dcat#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

:DistributionShape a sh:NodeShape ;
  sh:targetClass dcat:Distribution ;

  sh:property [
    sh:path dct:extent ;
    sh:name "Number of Records" ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "The distribution must specify the number of records it contains." ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:order 19 ;
] ;
  sh:property [
    sh:path dct:issued ;
    sh:name "Issued Date" ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "The issued date must be provided." ;
    dash:editor dash:DateTimePickerEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:order 20 ;
  ] ;

  sh:property [
    sh:path dct:modified ;
    sh:name "Modified Date" ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    dash:editor dash:DateTimePickerEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:order 21 ;
  ] ;

  sh:property [
    sh:path dcat:accessURL ;
    sh:name "Access URL" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A valid access URL must be provided." ;
    dash:editor dash:URIEditor ;
    dash:viewer dash:LabelViewer ;
    sh:order 22 ;
  ] ;

  sh:property [
    sh:path dcat:downloadURL ;
    sh:name "Download URL" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A valid download URL must be provided." ;
    dash:editor dash:URIEditor ;
    dash:viewer dash:LabelViewer ;
    sh:order 23 ;
  ] ;

  sh:property [
    sh:path dcat:mediaType ;
    sh:name "Media Type" ;
    sh:nodeKind sh:Literal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Media type (e.g., text/csv) is required." ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:order 24 ;
  ] ;

  sh:property [
    sh:path dcat:format ;
    sh:name "File Format" ;
    sh:nodeKind sh:Literal ;
    sh:maxCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:order 25 ;
  ] ;

  sh:property [
    sh:path dcat:byteSize ;
    sh:name "File Size" ;
    sh:nodeKind sh:Literal ;
    sh:maxCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:order 26 ;
  ] .
